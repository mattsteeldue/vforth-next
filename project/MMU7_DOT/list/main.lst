  14+ 2000              //  ______________________________________________________________________
  15+ 2000              //
  16+ 2000              // ZX-Spectrum standard system variables
  17+ 2000              SCR_CT          equ     $5C8C                   // SCR-CT system variable
  18+ 2000              LASTK           equ     $5C08                   // LASTK system variable
  19+ 2000              PIP             equ     $5C39                   // PIP system variable
  20+ 2000              BORDCR          equ     $5C48                   // BORDCR system variable
  21+ 2000              FLAGS2          equ     $5C6A                   // for caps-lock
  22+ 2000              RAMTOP          equ     $5CB2
  23+ 2000              TSTACK          equ     $5C00                   // TSTACK
  24+ 2000              // FSTACK          ecu     $4000 - 8
  25+ 2000              //  ______________________________________________________________________
  26+ 2000              //
  27+ 2000              // Flag constants
  28+ 2000              TRUE_FLAG       equ     $FFFF
  29+ 2000              FALSE_FLAG      equ     $0000
  30+ 2000
  31+ 2000              //  ______________________________________________________________________
  32+ 2000              //
  33+ 2000              // Ascii char constants
  34+ 2000              NUL_CHAR        equ     $00
  35+ 2000              COMMA_CHAR      equ     $06
  36+ 2000              BACKSPACE_CHAR  equ     $08
  37+ 2000              CR_CHAR         equ     $0D
  38+ 2000              BLANK_CHAR      equ     $20
  39+ 2000              QUOTE_CHAR      equ     "'"
  40+ 2000              DQUOTE_CHAR     equ     '"'
  41+ 2000              UNDERSCORE_CHAR equ     $5F
  42+ 2000              SOLIDBLOCK_CHAR equ     $8F
  43+ 2000              HALFBLOCK_CHAR  equ     $8C
  44+ 2000              LC_A_CHAR       equ     $61                 // lower-case "a"
  45+ 2000              LC_Z_CHAR       equ     $7A                 // lower-case "z"
  46+ 2000
  47+ 2000
  48+ 2000              //  ______________________________________________________________________
  49+ 2000              //
  50+ 2000
  51+ 2000                              // emulate something like:  ld hl,rp
  52+ 2000              ldhlrp          macro
  53+ 2000 ~                            ld      hl,(RP_Pointer)
  54+ 2000                              endm
  55+ 2000
  56+ 2000                              // emulate something like:  ld rp,hl
  57+ 2000              ldrphl          macro
  58+ 2000 ~                            ld      (RP_Pointer),hl
  59+ 2000                              endm
  60+ 2000
  61+ 2000              //  ______________________________________________________________________
  62+ 2000              //
  63+ 2000              //  Inner interpreter next-address pointer. This is 2T-state faster than "jp address"
  64+ 2000              next            macro
  65+ 2000 ~                            jp      (ix)
  66+ 2000                              endm
  67+ 2000
  68+ 2000              psh1            macro
  69+ 2000 ~                            push    hl
  70+ 2000 ~                            jp      (ix)
  71+ 2000                              endm
  72+ 2000
  73+ 2000
  74+ 2000              //  ______________________________________________________________________
  75+ 2000              //
  76+ 2000              // Bit constants in length-byte
  77+ 2000
  78+ 2000              SMUDGE_BIT      equ     %00100000               // $20
  79+ 2000              IMMEDIATE_BIT   equ     %01000000               // $40
  80+ 2000              END_BIT         equ     %10000000               // $80
  81+ 2000
  82+ 2000
  83+ 2000              //  ______________________________________________________________________
  84+ 2000              //
  85+ 2000              //  To create Forth words using this (nice) Assembler, we have to use the two following
  86+ 2000              //  pointers
  87+ 2000              temp_NFA        defl    0
  88+ 2000              last_NFA        defl    0
  89+ 2000              len_NFA         defl    0
  90+ 2000
  91+ 2000              Dict_Ptr        defl    0
  92+ 2000              // Heap_Ptr        defl    $0002
  93+ 2000              Prev_Ptr        defl    0
  94+ 2000              mirror_Ptr      defl    0
  95+ 2000
  96+ 2000              is_code         equ     0                   // so the direct machine-code starts at CFA
  97+ 2000              is_normal       equ     0                   // so the direct machine-code starts at CFA
  98+ 2000              is_immediate    equ     IMMEDIATE_BIT       // $40 - the definition is IMMEDIATE.
  99+ 2000
 100+ 2000
 101+ 2000              Behave          macro   xp
 102+ 2000 ~            temp_PTR        defl    $                   // save this org
 103+ 2000 ~                            org     (Heap_Ptr & $1FFF) + $E000 -2
 104+ 2000 ~                            dw      xp
 105+ 2000 ~                            org     temp_PTR
 106+ 2000                              endm
 107+ 2000
 108+ 2000              //  ______________________________________________________________________
 109+ 2000              //
 110+ 2000              //  Create a new "low-level" definition
 111+ 2000              //  This macro is used in the form  Create FORTH_NAME,n,"forth_name"
 112+ 2000              //  to create a new Forth Dictionary entry the same way Forth itself would do.
 113+ 2000              //  A word begins with a Length-Byte in range 1-31. Top 3 msb are used as flags
 114+ 2000              //  see SMUDGE_BIT and IMMEDIATE_BIT constant above.
 115+ 2000              //  It is followed by the Name of the word, i.e. a string expressed in 7-bit Ascii.
 116+ 2000              //  The last character of the Name must have the msb set to signal the end of it (END_BIT)
 117+ 2000              //  This macro acts much like the standard Forth definition CREATE
 118+ 2000
 119+ 2000              New_Def         macro   label, namec, runcode, bits
 120+ 2000 ~
 121+ 2000 ~            Dict_Ptr        defl    $
 122+ 2000 ~
 123+ 2000 ~            //              ______________________________________________________________________
 124+ 2000 ~            //              Heap part
 125+ 2000 ~
 126+ 2000 ~
 127+ 2000 ~                            org     (Heap_Ptr & $1FFF) + $E000
 128+ 2000 ~
 129+ 2000 ~            temp_NFA        defl    $                   // save this NFA address to temp_NFA
 130+ 2000 ~            Latest_Definition defl  Heap_Ptr
 131+ 2000 ~
 132+ 2000 ~                            // dummy db directives used to calculate length of namec
 133+ 2000 ~                            db      namec
 134+ 2000 ~            len_NFA         defl    $ - temp_NFA
 135+ 2000 ~                            org     $ - len_NFA         // rewind to temp_NFA and re-do NFA part
 136+ 2000 ~
 137+ 2000 ~                            db      len_NFA | END_BIT | bits  // The start of NFA must have msb set to signal the beginning of the sounted string
 138+ 2000 ~                            db      namec               // name string in 7-bit ascii, but
 139+ 2000 ~                            org     $-1                 // alter last byte of Name just above to set
 140+ 2000 ~                            db      {b $} | END_BIT     // msb as name end
 141+ 2000 ~
 142+ 2000 ~                            dw      Prev_Ptr  + Heap_offset     // Link to previous definition Name
 143+ 2000 ~            Prev_Ptr        defl    Heap_Ptr
 144+ 2000 ~
 145+ 2000 ~            mirror_Ptr      defl    $
 146+ 2000 ~
 147+ 2000 ~                            dw      Dict_Ptr + 2        // xt
 148+ 2000 ~            Heap_Ptr        defl    $ - $E000           // save current HP
 149+ 2000 ~
 150+ 2000 ~            Current_HP      defl  $ - $E000             // used to set HP once!
 151+ 2000 ~
 152+ 2000 ~            //              ______________________________________________________________________
 153+ 2000 ~            //              Dictionary part
 154+ 2000 ~
 155+ 2000 ~                            org     Dict_Ptr
 156+ 2000 ~
 157+ 2000 ~                            dw      mirror_Ptr - $E000 + Heap_offset
 158+ 2000 ~
 159+ 2000 ~            label:          if runcode != 0 ; ok        // This is the start address of the direct jp(hl)
 160+ 2000 ~                            call    runcode ; ok        // for primitive definitions  actual code
 161+ 2000 ~
 162+ 2000 ~
 163+ 2000 ~                            endif           ; ok        // for other definitions it "points" the correct handler
 164+ 2000 ~                            // Use of "; ok" to suppress "warning[fwdref]"
 165+ 2000 ~
 166+ 2000 ~            last_NFA        defl    temp_NFA            // keep track of NFA saved above
 167+ 2000                              endm
 168+ 2000
 169+ 2000              //  ______________________________________________________________________
 170+ 2000              //
 171+ 2000              // Create a "constant"
 172+ 2000              // The constant value is compiled in first PFA cell
 173+ 2000              Constant_Def    macro   label, namec, constant_value
 174+ 2000 ~                            New_Def  label, namec, Constant_Ptr, is_normal
 175+ 2000 ~                            dw      constant_value
 176+ 2000                              endm
 177+ 2000
 178+ 2000              //  ______________________________________________________________________
 179+ 2000              //
 180+ 2000              // Create a "variable"
 181+ 2000              // The when invoked, a variable returns a pointer, the address of first PFA cell
 182+ 2000              // this allow creation of "variables" which content is  of any length
 183+ 2000              Variable_Def    macro   label, namec, initial_value
 184+ 2000 ~                            New_Def  label, namec, Variable_Ptr, is_normal
 185+ 2000 ~                            dw      initial_value
 186+ 2000                              endm
 187+ 2000
 188+ 2000              //  ______________________________________________________________________
 189+ 2000              //
 190+ 2000              // Create a "user"
 191+ 2000              // It uses a single byte as offset to calculate the address of the variable
 192+ 2000              User_Def        macro   label, namec, offset_value
 193+ 2000 ~                            New_Def  label, namec, User_Ptr, is_normal
 194+ 2000 ~                            db      offset_value
 195+ 2000                              endm
 196+ 2000
 197+ 2000              //  ______________________________________________________________________
 198+ 2000              //
 199+ 2000              // Create a "colon-definition"
 200+ 2000              // The CFA contains a small routine i.e. "call Enter_Ptr".
 201+ 2000              // The PFA, three bytes later, contains the actual Forth definition
 202+ 2000              Colon_Def       macro   label, namec, bits
 203+ 2000 ~                            New_Def  label, namec, Enter_Ptr, bits ; ok
 204+ 2000                              endm
 205+ 2000
 206+ 2000              //  ______________________________________________________________________
 207+ 2000              //
 208+ 2000              // Create a "heap-string"
 209+ 2000              Start_Heap      macro
 210+ 2000 ~            temp_ORG        defl    $                   // save this ORG
 211+ 2000 ~                            org     (Heap_Ptr & $1FFF) + $E000
 212+ 2000 ~
 213+ 2000                              endm
 214+ 2000
 215+ 2000              End_Heap        macro
 216+ 2000 ~            Heap_Ptr        defl    $ - $E000
 217+ 2000 ~                            org     temp_ORG
 218+ 2000 ~
 219+ 2000                              endm
 220+ 2000
 221+ 2000
 222+ 2000              //  ______________________________________________________________________
 223+ 2000              //
 224+ 2000
 225+ 2000              LIMIT_system:   equ     $E000               // Address of first byte beyond last BUFFER
 226+ 2000              BUFFERS         equ     7                   // number of buffers available. must be the difference between LIMIT and FIRST divided by 516
 227+ 2000              FIRST_system:   equ     LIMIT_system - 516*BUFFERS // Address of first BUFFER
 228+ 2000              USER_system:    equ     FIRST_system - 80   // User variables zone.
 229+ 2000              R0_system:      equ     USER_system         // Address of top of Return Stack. This is S0 + $00A0
 230+ 2000              TIB_system      equ     R0_system - 160     // TIB grows upwards, Return-Stack downward.
 231+ 2000              S0_system:      equ     TIB_system          // Address of top of Calc Stack
 232+ 2000
