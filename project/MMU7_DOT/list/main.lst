 146  3FA0
 147  3FA0              // the dot command is saved as one 8K page, ORIGIN to ORIGIN+$1FFF
 148  3FA0              // (vforth.1 below): the core must end inside it
 149  3FA0              Core_Free       defl    ORIGIN + $2000 - (Here_Dictionary + 1)
 150  3FA0                              DISPLAY "DOT core: ", /D, Core_Free, " bytes free in 8K"
 151  3FA0                              ASSERT  Core_Free >= 0
 152  3FA0
 153  3FA0              // now we save the compiled file so we can either run it or debug it
 154  3FA0                              SAVENEX OPEN "output/main.nex", ORIGIN
 155  3FA0                              SAVENEX CORE 3, 0, 0                                // Next core 3.0.0 required as minimum
 156  3FA0                              SAVENEX CFG  0
 157  3FA0                              SAVENEX BANK 2, 0
 158  3FA0                              SAVENEX AUTO
 159  3FA0                              SAVENEX CLOSE
 160  3FA0
 161  3FA0              //              PAGE 7 ;set 7 page to current slot
 162  3FA0              //              SAVEBIN "ram7.bin",$C000,$4000 ;- save 4000h begin from C000h of RAM to file
 163  3FA0              //              SAVEBIN "output/ram2.bin", $8000, 9800 ;- save 3000h begin from 8000h of RAM to file
