 146  3F9E
 147  3F9E              // the dot command is saved as one 8K page, ORIGIN to ORIGIN+$1FFF
 148  3F9E              // (vforth.1 below): the core must end inside it
 149  3F9E              Core_Free       defl    ORIGIN + $2000 - (Here_Dictionary + 1)
 150  3F9E                              DISPLAY "DOT core: ", /D, Core_Free, " bytes free in 8K"
 151  3F9E                              ASSERT  Core_Free >= 0
 152  3F9E
 153  3F9E              // now we save the compiled file so we can either run it or debug it
 154  3F9E                              SAVENEX OPEN "output/main.nex", ORIGIN
 155  3F9E                              SAVENEX CORE 3, 0, 0                                // Next core 3.0.0 required as minimum
 156  3F9E                              SAVENEX CFG  0
 157  3F9E                              SAVENEX BANK 2, 0
 158  3F9E                              SAVENEX AUTO
 159  3F9E                              SAVENEX CLOSE
 160  3F9E
