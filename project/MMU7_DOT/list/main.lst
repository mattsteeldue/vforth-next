 445+ 2935              // >far         ha -- a n
 446+ 2935              // decode bits 765 of H as one of the 8K-page between 64 and 71 (40h-47h)
 447+ 2935              // take lower bits of H and L as an offset from E000h
 448+ 2935              // then return address  a  between E000h-FFFFh
 449+ 2935              // and page number n  between 64-71 (40h-47h)
 450+ 2935              // For example, in hex:
 451+ 2935              //   0000 >FAR  gives  40.E000
 452+ 2935              //   1FFF >FAR  gives  40.FFFF
 453+ 2935              //   2000 >FAR  gives  41.E000
 454+ 2935              //   3FFF >FAR  gives  41.FFFF
 455+ 2935              //   EFFF >FAR  gives  47.EFFF
 456+ 2935              //   FFFF >FAR  gives  47.FFFF
