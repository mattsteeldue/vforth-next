 146  3FB6
 147  3FB6              // the dot command is saved as one 8K page, ORIGIN to ORIGIN+$1FFF
 148  3FB6              // (vforth.1 below): the core must end inside it
 149  3FB6              Core_Free       defl    ORIGIN + $2000 - (Here_Dictionary + 1)
 150  3FB6                              DISPLAY "DOT core: ", /D, Core_Free, " bytes free in 8K"
 151  3FB6                              ASSERT  Core_Free >= 0
 152  3FB6
 153  3FB6              // now we save the compiled file so we can either run it or debug it
 154  3FB6                              SAVENEX OPEN "output/main.nex", ORIGIN
 155  3FB6                              SAVENEX CORE 3, 0, 0                                // Next core 3.0.0 required as minimum
 156  3FB6                              SAVENEX CFG  0
 157  3FB6                              SAVENEX BANK 2, 0
 158  3FB6                              SAVENEX AUTO
 159  3FB6                              SAVENEX CLOSE
 160  3FB6
 161  3FB6              //              PAGE 7 ;set 7 page to current slot
 162  3FB6              //              SAVEBIN "ram7.bin",$C000,$4000 ;- save 4000h begin from C000h of RAM to file
 163  3FB6              //              SAVEBIN "output/ram2.bin", $8000, 9800 ;- save 3000h begin from 8000h of RAM to file
 164  3FB6
 165  3FB6                      ////    SAVETAP "output/F16d.tap", CODE, "forth17d", ORIGIN, $2000
 166  3FB6                      ////    SAVETAP "output/F16e.tap", CODE, "forth17e", $E000, $2000
 167  3FB6
 168  3FB6                      ////    SAVEBIN "output/vforth", ORIGIN, $2000
 169  3FB6                      ////    SAVEBIN "output/vforth.bin", $E000, $2000 ;- save 2000h begin from E000h of RAM to file
 170  3FB6
 171  3FB6                              SAVEBIN "output/vforth.1", ORIGIN, $2000
 172  3FB6                              SAVEBIN "output/vforth.2", $E000, $2000 ;- save 2000h begin from E000h of RAM to file
 173  3FB6
