 169  3FA0                      ////    SAVEBIN "output/vforth.bin", $E000, $2000 ;- save 2000h begin from E000h of RAM to file
 170  3FA0
 171  3FA0                              SAVEBIN "output/vforth.1", ORIGIN, $2000
 172  3FA0                              SAVEBIN "output/vforth.2", $E000, $2000 ;- save 2000h begin from E000h of RAM to file
