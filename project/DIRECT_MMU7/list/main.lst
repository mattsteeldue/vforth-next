 131  6366              //  ______________________________________________________________________
 132  6366              //
 133  6366              //  Naming convention for Label vs Forth correspondance
 134  6366              //  Forth words are named as they are named for real with some exception to avoid assembler syntax errors.
 135  6366              //    - Leading "0" is converted into "Z_"
 136  6366              //    - Leading "(" is converted into "C_", closing bracket is omitted
 137  6366              //    - Leading numbers are converted in letters: ONE_  TWO_ etc.
 138  6366              //    - Question mark "?" is converted into "Q" or omitted if needed / useful.
 139  6366              //    - Plus sign "+" is converted in _PLUS or ADD_ depending.
 140  6366              //    - Minus sign "-" in L (for Line), MINUS or SUBTRACT depending
 141  6366              //    - Greater-Than sign ">" in _GREATER or TO_ depending
 142  6366              //    - Equal sign "=" is converted in EQUAL
 143  6366              //    - Less-Than sign "<" in _LESS or FROM_ (or TO_ again) depending
 144  6366              //    - Asterisk sign "*" is converted in _MUL or STAR
 145  6366              //    - Slash "/" is converted in _DIV or omitted if it is clear what it means
 146  6366              //    - Exclamation mark "!" is converted in STORE
 147  6366              //    - At-Sign "@" is converted in FETCH
 148  6366              //    - Words that collide with Assembler are normally suffixed with "_OP"
 149  6366
 150  6366                              include "system.asm"
