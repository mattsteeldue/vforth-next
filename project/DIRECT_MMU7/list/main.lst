  74  0000                              OPT     --zxnext
  75  0000              //  ______________________________________________________________________
  76  0000              //
  77  0000              // this controls some debugging code in L0.asm
  78  0000              //  0 for final binary release.
  79  0000              //  1 for debugging with Visual Studio Code and DeZog
  80  0000              // -1 for for binary comparison with Forth generated code.
  81  0000              DEBUGGING       equ     0
  82  0000              //
  83  0000              //  ______________________________________________________________________
  84  0000
  85  0000                              if ( -2 == DEBUGGING )
  86  0000 ~            // ORIGIN          equ     $6366 - $80                 // for binary comparison with single incremental compilation
  87  0000 ~            ORIGIN          equ     38949 - $80       // $9aba: HERE when first compilation begins.
  88  0000 ~            Heap_Ptr        defl    $1bc3 - $72       // HP before first compilation minus HP after second compilation
  89  0000 ~
  90  0000 ~            Heap_offset     defl    $02               // given by compilation
  91  0000 ~            //Heap_offset     defl    $104               // given by compilation
  92  0000 ~            //Heap_offset     defl    $2104               // given by compilation
  93  0000 ~
  94  0000                              endif
  95  0000              //  ______________________________________________________________________
  96  0000
  97  0000                              if ( -1 == DEBUGGING )
  98  0000 ~            // ORIGIN          equ     $6366 - $80                 // for binary comparison with double compilation
  99  0000 ~            ORIGIN          equ     $6366   -$80                   // for binary comparison with single compilation
 100  0000 ~            Heap_Ptr        defl    $0002              // HP before compilation
 101  0000 ~            Heap_offset     defl    $00                // given by compilation
 102  0000 ~
 103  0000                              endif
 104  0000              //  ______________________________________________________________________
 105  0000
 106  0000                              if (  0 == DEBUGGING )
 107  0000              ORIGIN          equ     $6366                   // binary and Tape
 108  0000              // ORIGIN          equ     $9A93                // binary and Tape
 109  0000              Heap_Ptr        defl    $0002
 110  0000              Heap_offset     defl     0
 111  0000
 112  0000                              endif
 113  0000              //  ______________________________________________________________________
 114  0000
 115  0000                              if (  1 == DEBUGGING )
 116  0000 ~            ORIGIN          equ     $8080                   // for DeZog
 117  0000 ~            Heap_Ptr        defl    $0002
 118  0000 ~            Heap_offset     defl     0
 119  0000 ~
 120  0000                              endif
