  48+ 6366              //  ______________________________________________________________________
  49+ 6366              //
  50+ 6366
  51+ 6366                              // emulate something like:  ld hl,rp
  52+ 6366              ldhlrp          macro
  53+ 6366 ~                            ld      hl,(RP_Pointer)
  54+ 6366                              endm
  55+ 6366
  56+ 6366                              // emulate something like:  ld rp,hl
  57+ 6366              ldrphl          macro
