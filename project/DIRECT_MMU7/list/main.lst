 227+ 6366              //  ______________________________________________________________________
 228+ 6366              //
 229+ 6366
 230+ 6366
 231+ 6366              LIMIT_system:   equ     $E000               // Address of first byte beyond last BUFFER
 232+ 6366              BUFFERS         equ     7                   // number of buffers available. must be the difference between LIMIT and FIRST divided by 516
 233+ 6366              FIRST_system:   equ     LIMIT_system - 516*BUFFERS // Address of first BUFFER
 234+ 6366              USER_system:    equ     FIRST_system - 80   // User variables zone.
 235+ 6366              R0_system:      equ     USER_system         // Address of top of Return Stack. This is S0 + $00A0
 236+ 6366              TIB_system      equ     R0_system - 160     // TIB grows upwards, Return-Stack downward.
 237+ 6366              S0_system:      equ     TIB_system          // Address of top of Calc Stack
 238+ 6366
 239+ 6366
 240+ 6366              // S0_system:      equ     $D0E8               // Address of top of Calc Stack
 241+ 6366              // TIB_system      equ     $D0E8               // TIB grows upwards, Return-Stack downward.
 242+ 6366              // R0_system:      equ     $D188               // Address of top of Return Stack. This is S0 + $00A0
 243+ 6366              // USER_system:    equ     $D188               // User variables zone.
 244+ 6366              // FIRST_system:   equ     $D1E4               // Address of first BUFFER
 245+ 6366              // LIMIT_system:   equ     $E000               // Address of first byte beyond last BUFFER
 246+ 6366
