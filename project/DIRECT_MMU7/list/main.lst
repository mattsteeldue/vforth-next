  61+ 6366              //  ______________________________________________________________________
  62+ 6366              //
  63+ 6366              //  Inner interpreter next-address pointer. This is 2T-state faster than "jp address"
  64+ 6366              next            macro
  65+ 6366 ~                            jp      (ix)
  66+ 6366                              endm
  67+ 6366
  68+ 6366              psh1            macro
  69+ 6366 ~                            push    hl
  70+ 6366 ~                            jp      (ix)
  71+ 6366                              endm
  72+ 6366
  73+ 6366              psh2            macro
  74+ 6366 ~                            push    de
  75+ 6366 ~                            push    hl
  76+ 6366 ~                            jp      (ix)
  77+ 6366                              endm
