  79+ 6366              //  ______________________________________________________________________
  80+ 6366              //
  81+ 6366              // Bit constants in length-byte
  82+ 6366
  83+ 6366              SMUDGE_BIT      equ     %00100000               // $20
  84+ 6366              IMMEDIATE_BIT   equ     %01000000               // $40
  85+ 6366              END_BIT         equ     %10000000               // $80
  86+ 6366
  87+ 6366
  88+ 6366              //  ______________________________________________________________________
  89+ 6366              //
  90+ 6366              //  To create Forth words using this (nice) Assembler, we have to use the two following
  91+ 6366              //  pointers
  92+ 6366              temp_NFA        defl    0
  93+ 6366              last_NFA        defl    0
  94+ 6366              len_NFA         defl    0
  95+ 6366
  96+ 6366              Dict_Ptr        defl    0
  97+ 6366              // Heap_Ptr        defl    $0002
  98+ 6366              Prev_Ptr        defl    0
  99+ 6366              mirror_Ptr      defl    0
 100+ 6366
 101+ 6366              is_code         equ     0                   // so the direct machine-code starts at CFA
 102+ 6366              is_normal       equ     0                   // so the direct machine-code starts at CFA
 103+ 6366              is_immediate    equ     IMMEDIATE_BIT       // $40 - the definition is IMMEDIATE.
 104+ 6366
 105+ 6366
 106+ 6366              Behave          macro   xp
 107+ 6366 ~            temp_PTR        defl    $                   // save this org
 108+ 6366 ~                            org     (Heap_Ptr & $1FFF) + $E000 -2
 109+ 6366 ~                            dw      xp
 110+ 6366 ~                            org     temp_PTR
 111+ 6366                              endm
 112+ 6366
 113+ 6366              //  ______________________________________________________________________
 114+ 6366              //
 115+ 6366              //  Create a new "low-level" definition
 116+ 6366              //  This macro is used in the form  Create FORTH_NAME,n,"forth_name"
 117+ 6366              //  to create a new Forth Dictionary entry the same way Forth itself would do.
 118+ 6366              //  A word begins with a Length-Byte in range 1-31. Top 3 msb are used as flags
 119+ 6366              //  see SMUDGE_BIT and IMMEDIATE_BIT constant above.
 120+ 6366              //  It is followed by the Name of the word, i.e. a string expressed in 7-bit Ascii.
 121+ 6366              //  The last character of the Name must have the msb set to signal the end of it (END_BIT)
 122+ 6366              //  This macro acts much like the standard Forth definition CREATE
 123+ 6366
 124+ 6366              New_Def         macro   label, namec, runcode, bits
 125+ 6366 ~
 126+ 6366 ~            Dict_Ptr        defl    $
 127+ 6366 ~
 128+ 6366 ~            //              ______________________________________________________________________
 129+ 6366 ~            //              Heap part
 130+ 6366 ~
 131+ 6366 ~
 132+ 6366 ~                            org     (Heap_Ptr & $1FFF) + $E000
 133+ 6366 ~
 134+ 6366 ~            temp_NFA        defl    $                   // save this NFA address to temp_NFA
 135+ 6366 ~            Latest_Definition defl  Heap_Ptr
 136+ 6366 ~
 137+ 6366 ~                            // dummy db directives used to calculate length of namec
 138+ 6366 ~                            db      namec
 139+ 6366 ~            len_NFA         defl    $ - temp_NFA
 140+ 6366 ~                            org     $ - len_NFA         // rewind to temp_NFA and re-do NFA part
 141+ 6366 ~
 142+ 6366 ~                            db      len_NFA | END_BIT | bits  // The start of NFA must have msb set to signal the beginning of the sounted string
 143+ 6366 ~                            db      namec               // name string in 7-bit ascii, but
 144+ 6366 ~                            org     $-1                 // alter last byte of Name just above to set
 145+ 6366 ~                            db      {b $} | END_BIT     // msb as name end
 146+ 6366 ~
 147+ 6366 ~                            dw      Prev_Ptr  + Heap_offset     // Link to previous definition Name
 148+ 6366 ~            Prev_Ptr        defl    Heap_Ptr
 149+ 6366 ~
 150+ 6366 ~            mirror_Ptr      defl    $
 151+ 6366 ~
 152+ 6366 ~                            dw      Dict_Ptr + 2        // xt
 153+ 6366 ~            Heap_Ptr        defl    $ - $E000           // save current HP
 154+ 6366 ~
 155+ 6366 ~            Current_HP      defl  $ - $E000             // used to set HP once!
 156+ 6366 ~
 157+ 6366 ~            //              ______________________________________________________________________
 158+ 6366 ~            //              Dictionary part
 159+ 6366 ~
 160+ 6366 ~                            org     Dict_Ptr
 161+ 6366 ~
 162+ 6366 ~                            dw      mirror_Ptr - $E000 + Heap_offset
 163+ 6366 ~
 164+ 6366 ~            label:          if runcode != 0 ; ok        // This is the start address of the direct jp(hl)
 165+ 6366 ~                            call    runcode ; ok        // for primitive definitions  actual code
 166+ 6366 ~
 167+ 6366 ~
 168+ 6366 ~                            endif           ; ok        // for other definitions it "points" the correct handler
 169+ 6366 ~                            // Use of "; ok" to suppress "warning[fwdref]"
 170+ 6366 ~
 171+ 6366 ~            last_NFA        defl    temp_NFA            // keep track of NFA saved above
 172+ 6366                              endm
 173+ 6366
 174+ 6366              //  ______________________________________________________________________
 175+ 6366              //
 176+ 6366              // Create a "constant"
 177+ 6366              // The constant value is compiled in first PFA cell
 178+ 6366              Constant_Def    macro   label, namec, constant_value
 179+ 6366 ~                            New_Def  label, namec, Constant_Ptr, is_normal
 180+ 6366 ~                            dw      constant_value
 181+ 6366                              endm
 182+ 6366
 183+ 6366              //  ______________________________________________________________________
 184+ 6366              //
 185+ 6366              // Create a "variable"
 186+ 6366              // The when invoked, a variable returns a pointer, the address of first PFA cell
 187+ 6366              // this allow creation of "variables" which content is  of any length
 188+ 6366              Variable_Def    macro   label, namec, initial_value
 189+ 6366 ~                            New_Def  label, namec, Variable_Ptr, is_normal
 190+ 6366 ~                            dw      initial_value
 191+ 6366                              endm
 192+ 6366
 193+ 6366              //  ______________________________________________________________________
 194+ 6366              //
 195+ 6366              // Create a "user" variable
 196+ 6366              // It uses a single byte as offset to calculate the address of the variable
 197+ 6366              User_Def        macro   label, namec, offset_value
 198+ 6366 ~                            New_Def  label, namec, User_Ptr, is_normal
 199+ 6366 ~                            db      offset_value
 200+ 6366                              endm
 201+ 6366
 202+ 6366              //  ______________________________________________________________________
 203+ 6366              //
 204+ 6366              // Create a "colon-definition"
 205+ 6366              // The CFA contains a small routine i.e. "call Enter_Ptr".
 206+ 6366              // The PFA, three bytes later, contains the actual Forth definition
 207+ 6366              Colon_Def       macro   label, namec, bits
 208+ 6366 ~                            New_Def  label, namec, Enter_Ptr, bits ; ok
 209+ 6366                              endm
 210+ 6366
 211+ 6366              //  ______________________________________________________________________
 212+ 6366              //
 213+ 6366              // Create a "heap-string"
 214+ 6366              Start_Heap      macro
 215+ 6366 ~            temp_ORG        defl    $                   // save this ORG
 216+ 6366 ~                            org     (Heap_Ptr & $1FFF) + $E000
 217+ 6366 ~
 218+ 6366                              endm
 219+ 6366
 220+ 6366              End_Heap        macro
 221+ 6366 ~            Heap_Ptr        defl    $ - $E000
 222+ 6366 ~                            org     temp_ORG
 223+ 6366 ~
 224+ 6366                              endm
 225+ 6366
