  16+ 6366              // ZX-Spectrum standard system variables
  17+ 6366              SCR_CT          equ     $5C8C                   // SCR-CT system variable
  18+ 6366              LASTK           equ     $5C08                   // LASTK system variable
  19+ 6366              PIP             equ     $5C39                   // PIP system variable
  20+ 6366              BORDCR          equ     $5C48                   // BORDCR system variable
  21+ 6366              FLAGS2          equ     $5C6A                   // for caps-lock
  22+ 6366              RAMTOP          equ     $5CB2
  23+ 6366              TSTACK          equ     $5C00                   // TSTACK
  24+ 6366              // FSTACK          ecu     $4000 - 8
  25+ 6366              //  ______________________________________________________________________
  26+ 6366              //
  27+ 6366              // Flag constants
  28+ 6366              TRUE_FLAG       equ     $FFFF
  29+ 6366              FALSE_FLAG      equ     $0000
  30+ 6366
  31+ 6366              //  ______________________________________________________________________
  32+ 6366              //
  33+ 6366              // Ascii char constants
  34+ 6366              NUL_CHAR        equ     $00
  35+ 6366              COMMA_CHAR      equ     $06
  36+ 6366              BACKSPACE_CHAR  equ     $08
  37+ 6366              CR_CHAR         equ     $0D
  38+ 6366              BLANK_CHAR      equ     $20
  39+ 6366              QUOTE_CHAR      equ     "'"
  40+ 6366              DQUOTE_CHAR     equ     '"'
  41+ 6366              UNDERSCORE_CHAR equ     $5F
  42+ 6366              SOLIDBLOCK_CHAR equ     $8F
  43+ 6366              HALFBLOCK_CHAR  equ     $8C
  44+ 6366              LC_A_CHAR       equ     $61                 // lower-case "a"
  45+ 6366              LC_Z_CHAR       equ     $7A                 // lower-case "z"
