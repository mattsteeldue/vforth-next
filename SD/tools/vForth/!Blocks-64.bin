                              ( TEST )                                                        CREATE ANAME ," /tools/vforth/mytest.bin"                       : BUFER 1 BUFFER ;                                              \                                                               : SAVE-BUFER                                                      1+ 0 [ HEX ] 0E                                                 F_OPEN   41 ?ERROR                                              DUP BUFER 255 ROT                                               F_WRITE  47 ?ERROR                                              DROP                                                            F_CLOSE  42 ?ERROR                                            ;                                                               : START                                                           ANAME SAVE-BUFER                                              ;                                                                                                                               ( map - character replacing )                                   \ translate c using mapping a1 -> a2. n is mapping length       code (map) ( a2 a1 n c1 -- c2 )                                   exx                                                             pop   hl|               \ c                                     ld    a'|   l|          \ character to map                      pop   bc|               \ n length of a1 map-string             pop   hl|               \ a1 map-string                         ld    d'|   b|                                                  ld    e'|   c|          \ length in de too                      cpir                                                          -->                                                                                                                                                                                                                                               